    "print(\"User: Explain containerization in two short sentences.\")\n",
    "print(\"Bot :\", ask_bot(\"Explain containerization in two short sentences.\"), \"\\n\")\n",
    "\n",
    "print(\"User: Give one example of how a district portal uses it.\")\n",
    "print(\"Bot :\", ask_bot(\"Give one example of how a district portal uses it.\"))"
